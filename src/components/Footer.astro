---
import Default from '@astrojs/starlight/components/Footer.astro';
const year = new Date().getFullYear();
---

<Default {...Astro.props}><slot /></Default>

<div class="site-footer-spacer"></div>
<div class="site-footer">© {year} Труб М.Д.</div>

<style>
	.site-footer-spacer {
		height: 2.5rem;
	}
	.site-footer {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		z-index: calc(var(--sl-z-index-menu, 5) + 1);
		display: flex;
		align-items: center;
		height: 2.5rem;
		padding: 0 var(--sl-nav-pad-x, 1.5rem);
		background: var(--sl-color-bg-nav);
		border-top: 1px solid var(--sl-color-hairline-shade);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
